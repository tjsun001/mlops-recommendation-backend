{
  "containerDefinitions": [
    {
      "name": "product-service",
      "image": "080967118593.dkr.ecr.us-east-1.amazonaws.com/product-service:no-db-20260218-190122",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 5050,
          "hostPort": 5050,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "SPRING_CONFIG_LOCATION",
          "value": "classpath:/does-not-exist/"
        },
        {
          "name": "SPRING_KAFKA_LISTENER_AUTO_STARTUP",
          "value": "true"
        },
        {
          "name": "MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS",
          "value": "always"
        },
        {
          "name": "SPRING_AUTOCONFIGURE_EXCLUDE",
          "value": "org.springframework.boot.autoconfigure.jdbc.DataSourceAutoConfiguration,org.springframework.boot.autoconfigure.orm.jpa.HibernateJpaAutoConfiguration,org.springframework.boot.autoconfigure.flyway.FlywayAutoConfiguration"
        },
        {
          "name": "JAVA_TOOL_OPTIONS",
          "value": "-Dspring.flyway.enabled=false -Dspring.data.jpa.repositories.enabled=false -Dspring.autoconfigure.exclude=org.springframework.boot.autoconfigure.jdbc.DataSourceAutoConfiguration,org.springframework.boot.autoconfigure.orm.jpa.HibernateJpaAutoConfiguration,org.springframework.boot.autoconfigure.flyway.FlywayAutoConfiguration"
        },
        {
          "name": "SPRING_JPA_ENABLED",
          "value": "false"
        },
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": ""
        },
        {
          "name": "MANAGEMENT_HEALTH_KAFKA_ENABLED",
          "value": "false"
        },
        {
          "name": "MANAGEMENT_ENDPOINT_HEALTH_SHOW_COMPONENTS",
          "value": "always"
        },
        {
          "name": "SPRING_DATA_JPA_REPOSITORIES_ENABLED",
          "value": "false"
        },
        {
          "name": "SPRING_FLYWAY_ENABLED",
          "value": "false"
        }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/mlops-poc-dev-product-service",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:5050/actuator/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "systemControls": []
    }
  ],
  "family": "mlops-poc-dev-product-service",
  "taskRoleArn": "arn:aws:iam::080967118593:role/mlops-poc-dev-ecs-task-role",
  "executionRoleArn": "arn:aws:iam::080967118593:role/mlops-poc-dev-ecs-task-exec-role",
  "networkMode": "awsvpc",
  "volumes": [],
  "placementConstraints": [],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024"
}
